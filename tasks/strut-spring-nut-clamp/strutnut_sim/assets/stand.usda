#usda 1.0
(
    defaultPrim = "stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stand" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:physics = </stand/PhysicsMaterials/painted_steel> (
        bindMaterialAs = "weakerThanDescendants"
    )

    def "Looks"
    {
        def Material "perma_green"
        {
            token outputs:surface.connect = </stand/Looks/perma_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.42, 0.24)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </stand/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.78)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "bolt"
        {
            token outputs:surface.connect = </stand/Looks/bolt/Shader.outputs:surface>

