    def "joints"
    {
        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </breakers/base>
        }

        def PhysicsRevoluteJoint "toggle_0_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </breakers/base>
            rel physics:body1 = </breakers/toggle_0>
            point3f physics:localPos0 = (-0.057, -0.035, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -28
            float physics:upperLimit = 28
        }

