        def Material "dark"
        {
            token outputs:surface.connect = </rig/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

