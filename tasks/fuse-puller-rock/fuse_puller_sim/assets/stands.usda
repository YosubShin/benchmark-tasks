#usda 1.0
(
    defaultPrim = "stands"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stands"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stands/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "tray"
        {
            token outputs:surface.connect = </stands/Looks/tray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.3, 0.7)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Cube "holder_base" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.04, 0.056, 0.04)
        double3 xformOp:translate = (0.31, -0.175, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holder_wx0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.012, 0.056, 0.02)
        double3 xformOp:translate = (0.296, -0.175, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holder_wy0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.016, 0.0105, 0.02)
        double3 xformOp:translate = (0.31, -0.19774999999999998, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holder_wx1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.012, 0.056, 0.02)
        double3 xformOp:translate = (0.324, -0.175, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holder_wy1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        custom float physxCollision:contactOffset = 0.002
