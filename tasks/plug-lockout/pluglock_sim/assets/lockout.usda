                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "plate"
        {
            token outputs:surface.connect = </lockout/Looks/plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "slot"
        {
            token outputs:surface.connect = </lockout/Looks/slot/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cord"
        {
            token outputs:surface.connect = </lockout/Looks/cord/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "clamp"
        {
            token outputs:surface.connect = </lockout/Looks/clamp/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.72)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lockout_red"
        {
            token outputs:surface.connect = </lockout/Looks/lockout_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.05, 0.04)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </lockout/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "fixture"
        {
            token outputs:surface.connect = </lockout/Looks/fixture/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.25, 0.27)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </lockout/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label"
        {
            token outputs:surface.connect = </lockout/Looks/label/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </lockout/Looks/label/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./lockout_label.png@
                float2 inputs:st.connect = </lockout/Looks/label/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

