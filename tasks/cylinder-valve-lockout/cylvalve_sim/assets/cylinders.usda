#usda 1.0
(
    defaultPrim = "cylinders"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cylinders" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "brass"
        {
            token outputs:surface.connect = </cylinders/Looks/brass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.66, 0.36)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "alu"
        {
            token outputs:surface.connect = </cylinders/Looks/alu/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.78)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </cylinders/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.67)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </cylinders/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lockout_red"
        {
            token outputs:surface.connect = </cylinders/Looks/lockout_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.07, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label_yellow"
        {
            token outputs:surface.connect = </cylinders/Looks/label_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.98, 0.8, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </cylinders/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "well"
        {
            token outputs:surface.connect = </cylinders/Looks/well/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.22)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "target_shoulder"
        {
            token outputs:surface.connect = </cylinders/Looks/target_shoulder/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.33, 0.17)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "decoy_shoulder"
        {
            token outputs:surface.connect = </cylinders/Looks/decoy_shoulder/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.92)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "body_grey"
        {
            token outputs:surface.connect = </cylinders/Looks/body_grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label_target"
        {
            token outputs:surface.connect = </cylinders/Looks/label_target/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </cylinders/Looks/label_target/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./label_target.png@
                float2 inputs:st.connect = </cylinders/Looks/label_target/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "label_decoy"
        {
            token outputs:surface.connect = </cylinders/Looks/label_decoy/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </cylinders/Looks/label_decoy/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./label_decoy.png@
                float2 inputs:st.connect = </cylinders/Looks/label_decoy/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

