#usda 1.0
(
    defaultPrim = "cover"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cover" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "station"
        {
            token outputs:surface.connect = </cover/Looks/station/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </cover/Looks/chrome/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_green"
        {
            token outputs:surface.connect = </cover/Looks/cap_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.55, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_red"
        {
            token outputs:surface.connect = </cover/Looks/cap_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.06, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </cover/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "legend"
        {
            token outputs:surface.connect = </cover/Looks/legend/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </cover/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "clear"
        {
            token outputs:surface.connect = </cover/Looks/clear/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.86, 0.94)
                float inputs:ior = 1
                float inputs:opacity = 0.55
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }
    }

