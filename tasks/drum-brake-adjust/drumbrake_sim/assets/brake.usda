#usda 1.0
(
    defaultPrim = "brake"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "brake" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    rel material:binding:physics = </brake/PhysicsMaterials/steel> (
        bindMaterialAs = "weakerThanDescendants"
    )
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "plate"
        {
            token outputs:surface.connect = </brake/Looks/plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "drum"
        {
            token outputs:surface.connect = </brake/Looks/drum/Shader.outputs:surface>

