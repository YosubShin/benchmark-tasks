                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </cord_target/cord_21/Looks/tag_target_legend/tex.outputs:rgb>
                    float inputs:roughness = 0.6
                    token outputs:surface
                }

                def Shader "stReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./tag_target.png@
                    float2 inputs:st.connect = </cord_target/cord_21/Looks/tag_target_legend/stReader.outputs:result>
                    token inputs:wrapS = "clamp"
                    token inputs:wrapT = "clamp"
                    float3 outputs:rgb
                }
            }
        }

