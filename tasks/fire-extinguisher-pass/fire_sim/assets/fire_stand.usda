#usda 1.0
(
    defaultPrim = "fire_stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fire_stand" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </fire_stand/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.46, 0.48)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "pan"
        {
            token outputs:surface.connect = </fire_stand/Looks/pan/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.31, 0.33)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "fuel"
        {
            token outputs:surface.connect = </fire_stand/Looks/fuel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.11, 0.08)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "tape"
        {
            token outputs:surface.connect = </fire_stand/Looks/tape/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.98, 0.82, 0.05)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </fire_stand/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "stand" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.14, 0.26, 0.24)
        double3 xformOp:translate = (0.6000000000000001, -0.049999999999999996, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pan_floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/pan>
        double size = 1
        float3 xformOp:scale = (0.14, 0.26, 0.002)
        double3 xformOp:translate = (0.6000000000000001, -0.049999999999999996, 0.241)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pan_front" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/pan>
        double size = 1
        float3 xformOp:scale = (0.005, 0.26, 0.04)
        double3 xformOp:translate = (0.5325, -0.049999999999999996, 0.26)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pan_back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/pan>
        double size = 1
        float3 xformOp:scale = (0.005, 0.26, 0.04)
        double3 xformOp:translate = (0.6675000000000001, -0.049999999999999996, 0.26)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pan_left" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/pan>
        double size = 1
        float3 xformOp:scale = (0.14, 0.005, 0.04)
        double3 xformOp:translate = (0.6000000000000001, 0.0775, 0.26)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pan_right" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/pan>
        double size = 1
        float3 xformOp:scale = (0.14, 0.005, 0.04)
        double3 xformOp:translate = (0.6000000000000001, -0.1775, 0.26)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "fuel" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/fuel>
        double size = 1
        float3 xformOp:scale = (0.13, 0.25, 0.038)
        double3 xformOp:translate = (0.6000000000000001, -0.049999999999999996, 0.259)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tape_front" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/tape>
        double size = 1
        float3 xformOp:scale = (0.025, 0.71, 0.0008)
        double3 xformOp:translate = (0.3175, -0.049999999999999996, 0.0004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tape_left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/tape>
        double size = 1
        float3 xformOp:scale = (0.57, 0.025, 0.0008)
        double3 xformOp:translate = (0.615, 0.29250000000000004, 0.0004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "tape_right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </fire_stand/Looks/tape>
        double size = 1
        float3 xformOp:scale = (0.57, 0.025, 0.0008)
        double3 xformOp:translate = (0.615, -0.3925, 0.0004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

