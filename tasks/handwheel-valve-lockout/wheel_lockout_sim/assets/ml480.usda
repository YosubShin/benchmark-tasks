#usda 1.0
(
    defaultPrim = "ml480"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ml480" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "red"
        {
            token outputs:surface.connect = </ml480/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.06, 0.05)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "red_b"
        {
            token outputs:surface.connect = </ml480/Looks/red_b/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.05, 0.04)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "label"
        {
            token outputs:surface.connect = </ml480/Looks/label/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.93)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

