#usda 1.0
(
    defaultPrim = "stands"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stands"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stands/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "lock_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.05, 0.05, 0.01)
        double3 xformOp:translate = (0.14, 0.14, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "lock_column" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.01, 0.012, 0.113)
        double3 xformOp:translate = (0.14, 0.14, 0.0565)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "cover_pedestal" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.045, 0.045, 0.08)
        double3 xformOp:translate = (0.13, -0.13, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "cover_pedestal_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.07, 0.07, 0.008)
        double3 xformOp:translate = (0.13, -0.13, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

