    def Xform "anchor" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.22, -0.43, 0.0015)
        float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
        float physics:mass = 0.05
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "clamp"
        {
            float xformOp:rotateZ = 85
            double3 xformOp:translate = (0.22, -0.43, 0.0015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "strap" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </cord_decoy/Looks/clamp>
                double size = 1
                float3 xformOp:scale = (0.012, 0.028, 0.002)
                double3 xformOp:translate = (0, 0, 0.005)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "tail" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </cord_decoy/Looks/cord>
                double size = 1
                float3 xformOp:scale = (0.04, 0.008, 0.008)
                double3 xformOp:translate = (-0.02, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

