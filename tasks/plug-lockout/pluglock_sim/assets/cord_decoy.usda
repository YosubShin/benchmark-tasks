        def "Looks"
        {
            def Material "tag_decoy_color"
            {
                token outputs:surface.connect = </cord_decoy/cord_21/Looks/tag_decoy_color/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.1, 0.62, 0.22)
                    float inputs:roughness = 0.5
                    token outputs:surface
                }
            }

            def Material "tag_decoy_legend"
            {
                token outputs:surface.connect = </cord_decoy/cord_21/Looks/tag_decoy_legend/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </cord_decoy/cord_21/Looks/tag_decoy_legend/tex.outputs:rgb>
                    float inputs:roughness = 0.6
                    token outputs:surface
                }

                def Shader "stReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./tag_decoy.png@
                    float2 inputs:st.connect = </cord_decoy/cord_21/Looks/tag_decoy_legend/stReader.outputs:result>
                    token inputs:wrapS = "clamp"
                    token inputs:wrapT = "clamp"
                    float3 outputs:rgb
                }
            }
        }

