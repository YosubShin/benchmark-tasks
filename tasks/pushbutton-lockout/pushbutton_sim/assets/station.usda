#usda 1.0
(
    defaultPrim = "station"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "station" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "station"
        {
            token outputs:surface.connect = </station/Looks/station/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </station/Looks/chrome/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_green"
        {
            token outputs:surface.connect = </station/Looks/cap_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.55, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_red"
        {
            token outputs:surface.connect = </station/Looks/cap_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.06, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </station/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "legend"
        {
            token outputs:surface.connect = </station/Looks/legend/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </station/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "clear"
        {
            token outputs:surface.connect = </station/Looks/clear/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.86, 0.94)
                float inputs:ior = 1
                float inputs:opacity = 0.55
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "legend_start"
        {
            token outputs:surface.connect = </station/Looks/legend_start/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </station/Looks/legend_start/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./legend_start.png@
                float2 inputs:st.connect = </station/Looks/legend_start/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "legend_stop"
        {
            token outputs:surface.connect = </station/Looks/legend_stop/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </station/Looks/legend_stop/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./legend_stop.png@
                float2 inputs:st.connect = </station/Looks/legend_stop/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

    def Xform "enclosure" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 2
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

