#usda 1.0
(
    defaultPrim = "rig"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "rig" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:physics = </rig/PhysicsMaterials/galvanized> (
        bindMaterialAs = "weakerThanDescendants"
    )

    def "Looks"
    {
        def Material "galv"
        {
            token outputs:surface.connect = </rig/Looks/galv/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.74)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </rig/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.8, 0.82)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "strut"
        {
            token outputs:surface.connect = </rig/Looks/strut/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "jacket"
        {
            token outputs:surface.connect = </rig/Looks/jacket/Shader.outputs:surface>

