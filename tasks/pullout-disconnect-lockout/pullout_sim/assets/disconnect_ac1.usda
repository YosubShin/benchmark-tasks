    def "joints"
    {
        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </disconnect/body>
        }

        def PhysicsRevoluteJoint "cover_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </disconnect/body>
            rel physics:body1 = </disconnect/cover>
            point3f physics:localPos0 = (0.44, 0, 0.288)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 120
        }
    }

