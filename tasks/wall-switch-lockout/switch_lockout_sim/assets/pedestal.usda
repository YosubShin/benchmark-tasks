#usda 1.0
(
    defaultPrim = "pedestal"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "pedestal"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </pedestal/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </pedestal/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.06, 0.06, 0.01)
        double3 xformOp:translate = (0.215, 0.12, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "post" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </pedestal/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.014, 0.014, 0.118)
        double3 xformOp:translate = (0.215, 0.12, 0.05900000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "lip_front" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </pedestal/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.0015, 0.024, 0.006)
        double3 xformOp:translate = (0.20425, 0.12, 0.11900000000000002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "lip_back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </pedestal/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.0015, 0.024, 0.006)
        double3 xformOp:translate = (0.22575, 0.12, 0.11900000000000002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "cradle" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </pedestal/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.023, 0.024, 0.004)
        double3 xformOp:translate = (0.215, 0.12, 0.11600000000000002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "park_shelf" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </pedestal/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.12, 0.6, 0.01)
        double3 xformOp:translate = (0.3, 0, -0.305)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

