#usda 1.0
(
    defaultPrim = "block"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "block" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    rel material:binding:physics = </block/PhysicsMaterials/grip_plastic> (
        bindMaterialAs = "weakerThanDescendants"
    )
    float physics:mass = 0.1
    custom float physxRigidBody:angularDamping = 1
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "block_black"
        {
            token outputs:surface.connect = </block/Looks/block_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.055)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </block/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.45, 0.22)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </block/Looks/white/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.91)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "body" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </block/Looks/block_black>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.018, 0.096, 0.044)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "grip" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </block/Looks/block_black>
        custom float physxCollision:contactOffset = 0.002
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.016, 0.06, 0.014)
        double3 xformOp:translate = (-0.017, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

