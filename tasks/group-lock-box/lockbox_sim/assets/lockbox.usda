#usda 1.0
(
    defaultPrim = "lockbox"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "lockbox" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "box_red"
        {
            token outputs:surface.connect = </lockbox/Looks/box_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.05, 0.04)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "riser"
        {
            token outputs:surface.connect = </lockbox/Looks/riser/Shader.outputs:surface>

