    def "joints"
    {
        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </cutout/base>
        }

        def PhysicsPrismaticJoint "lift_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </cutout/base>
            rel physics:body1 = </cutout/carrier>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.025
        }

        def PhysicsRevoluteJoint "swing_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </cutout/carrier>
            rel physics:body1 = </cutout/tube>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -178
            float physics:upperLimit = 1
        }
    }

