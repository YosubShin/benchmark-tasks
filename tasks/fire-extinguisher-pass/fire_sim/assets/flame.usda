#usda 1.0
(
    defaultPrim = "flame"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "flame" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = 1
    float physics:mass = 0.01

    def "Looks"
    {
        def Material "flame_outer"
        {
            token outputs:surface.connect = </flame/Looks/flame_outer/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.16, 0.01)
                color3f inputs:emissiveColor = (1.6, 0.256, 0.016)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "flame_inner"
        {
            token outputs:surface.connect = </flame/Looks/flame_inner/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.48, 0.04)
                color3f inputs:emissiveColor = (2, 0.96, 0.08)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cylinder "base" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.024
        rel material:binding = </flame/Looks/flame_outer>
        double radius = 0.036
        double3 xformOp:translate = (0, 0, 0.012)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "outer" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.08099999999999999
        rel material:binding = </flame/Looks/flame_outer>
        double radius = 0.036
        double3 xformOp:translate = (0, 0, 0.0645)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "lick_a" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.09
        rel material:binding = </flame/Looks/flame_outer>
        double radius = 0.0198
        double3 xformOp:translate = (0.008, 0.012, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "lick_b" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.08
        rel material:binding = </flame/Looks/flame_outer>
        double radius = 0.018
        double3 xformOp:translate = (-0.006, -0.014, 0.045)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "core_base" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.0245
        rel material:binding = </flame/Looks/flame_inner>
        double radius = 0.02232
        double3 xformOp:translate = (0, 0, 0.012)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "core" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </flame/Looks/flame_inner>
        double radius = 0.02232
        double3 xformOp:translate = (0, 0, 0.054)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

