#usda 1.0
(
    defaultPrim = "stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stand"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stand/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Cube "meter_block" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.12, 0.09, 0.023933515)
        double3 xformOp:translate = (0.5015000000000001, 0.28, 0.011966757233484707)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holster_0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.007, 0.024, 0.085)
        double3 xformOp:translate = (0.3465, 0.38, 0.0425)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holster_1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.01, 0.007, 0.085)
        double3 xformOp:translate = (0.355, 0.3715, 0.0425)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holster_2" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.01, 0.007, 0.085)
        double3 xformOp:translate = (0.355, 0.3885, 0.0425)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "holster_3" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.007, 0.024, 0.085)
        double3 xformOp:translate = (0.3635, 0.38, 0.0425)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

