        def Material "perma_green"
        {
            token outputs:surface.connect = </kit/Looks/perma_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.42, 0.24)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "zinc"
