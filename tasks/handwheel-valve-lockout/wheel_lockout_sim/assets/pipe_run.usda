        def Material "tex_wheelvalve_tag_V21"
        {
            token outputs:surface.connect = </pipe_run/Looks/tex_wheelvalve_tag_V21/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </pipe_run/Looks/tex_wheelvalve_tag_V21/tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./wheelvalve_tag_V21.png@
                float2 inputs:st.connect = </pipe_run/Looks/tex_wheelvalve_tag_V21/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }

        def Material "tex_wheelvalve_tag_V23"
