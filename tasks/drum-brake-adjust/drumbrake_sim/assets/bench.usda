#usda 1.0
(
    defaultPrim = "bench"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bench" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding:physics = </bench/PhysicsMaterials/wood> (
        bindMaterialAs = "weakerThanDescendants"
    )

    def "Looks"
    {
        def Material "plate"
        {
            token outputs:surface.connect = </bench/Looks/plate/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "drum"
        {
            token outputs:surface.connect = </bench/Looks/drum/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.34, 0.33)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "drum_face"
        {
            token outputs:surface.connect = </bench/Looks/drum_face/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.27, 0.27)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </bench/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.78)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </bench/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "black_oxide"
        {
            token outputs:surface.connect = </bench/Looks/black_oxide/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "grip"
        {
            token outputs:surface.connect = </bench/Looks/grip/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.05, 0.03)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </bench/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.32, 0.55)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </bench/Looks/rubber/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "wood"
        {
            token outputs:surface.connect = </bench/Looks/wood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.56, 0.36)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </bench/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "shoe"
        {
            token outputs:surface.connect = </bench/Looks/shoe/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.4, 0.33)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "rest_a" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </bench/Looks/wood>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.04, 0.015, 0.06545)
        double3 xformOp:translate = (0.22, -0.1225, 0.032725)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "rest_b" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </bench/Looks/wood>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.04, 0.018, 0.06)
        double3 xformOp:translate = (0.22, -0.3186, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "plug_body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.006
        rel material:binding = </bench/Looks/rubber>
        double radius = 0.012
        double3 xformOp:translate = (0.2, -0.06, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "plug_lip" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.003
        rel material:binding = </bench/Looks/rubber>
        double radius = 0.0085
        double3 xformOp:translate = (0.2, -0.06, 0.0075)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "PhysicsMaterials"
    {
        def Material "wood" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            custom token physxMaterial:frictionCombineMode = "average"
        }
    }
}

