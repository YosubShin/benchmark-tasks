#usda 1.0
(
    defaultPrim = "stands"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stands"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stands/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "lock_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.05, 0.05, 0.01)
        double3 xformOp:translate = (0.24, 0.08, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "lock_column" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.012, 0.016, 0.15)
        double3 xformOp:translate = (0.256, 0.08, 0.075)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pocket_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.06, 0.11, 0.01)
        double3 xformOp:translate = (0.27, 0.155, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pocket_base" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.016, 0.09, 0.023)
        double3 xformOp:translate = (0.27, 0.155, 0.01150000000000001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pocket_wall0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.006, 0.09, 0.08)
        double3 xformOp:translate = (0.265, 0.155, 0.06300000000000003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "pocket_wall1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.006, 0.09, 0.08)
        double3 xformOp:translate = (0.275, 0.155, 0.06300000000000003)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "park_shelf" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stands/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.12, 0.6, 0.01)
        double3 xformOp:translate = (0.3, 0, -0.305)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

