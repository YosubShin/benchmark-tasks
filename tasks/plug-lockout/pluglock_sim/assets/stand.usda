    def Cube "block" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.1005, 0.12, 0.1267)
        double3 xformOp:translate = (0.24575, -0.04000000000000001, 0.06085)
