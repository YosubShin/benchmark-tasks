#usda 1.0
(
    defaultPrim = "stands"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stands"
{
    def "Looks"
    {
        def Material "stand"
        {
            token outputs:surface.connect = </stands/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

