#usda 1.0
(
    defaultPrim = "shield"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "shield" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "MaterialBindingAPI"]
)
{
    rel material:binding:physics = </shield/PhysicsMaterials/galv_sheet> (
        bindMaterialAs = "weakerThanDescendants"
    )
    point3f physics:centerOfMass = (0, 0, -0.02367147)
    float3 physics:diagonalInertia = (0.0028689299, 0.00047034578, 0.0028689299)
    float physics:mass = 0.34019428
    quatf physics:principalAxes = (1, 0, 0, 0)
    custom bool physxRigidBody:enableCCD = 0
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom int physxRigidBody:solverPositionIterationCount = 32
    custom int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "galv"
        {
            token outputs:surface.connect = </shield/Looks/galv/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.72, 0.74)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </shield/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.8, 0.82)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "strut"
        {
            token outputs:surface.connect = </shield/Looks/strut/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "jacket"
        {
            token outputs:surface.connect = </shield/Looks/jacket/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </shield/Looks/copper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.45, 0.2)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </shield/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.04, 0.03)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "wood"
        {
            token outputs:surface.connect = </shield/Looks/wood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.56, 0.36)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </shield/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Cube "strip_00" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
