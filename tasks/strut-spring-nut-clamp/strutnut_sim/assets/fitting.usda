#usda 1.0
(
    defaultPrim = "fitting"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fitting" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    rel material:binding:physics = </fitting/PhysicsMaterials/zinc> (
        bindMaterialAs = "weakerThanDescendants"
    )
    float physics:mass = 0.077
    custom float physxRigidBody:maxDepenetrationVelocity = 0.5
    custom int physxRigidBody:solverPositionIterationCount = 32

    def "Looks"
    {
        def Material "perma_green"
        {
            token outputs:surface.connect = </fitting/Looks/perma_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.42, 0.24)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "zinc"
        {
            token outputs:surface.connect = </fitting/Looks/zinc/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.76, 0.78)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "bolt"
        {
            token outputs:surface.connect = </fitting/Looks/bolt/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "nut"
        {
            token outputs:surface.connect = </fitting/Looks/nut/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.66, 0.6)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "spring"
        {
            token outputs:surface.connect = </fitting/Looks/spring/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.32)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </fitting/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.04, 0.03)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "wood"
        {
            token outputs:surface.connect = </fitting/Looks/wood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.56, 0.36)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "galv"
        {
            token outputs:surface.connect = </fitting/Looks/galv/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.62, 0.64)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </fitting/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Cube "plate_n" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </fitting/Looks/zinc>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.01349375, 0.041275, 0.00635)
        double3 xformOp:translate = (-0.013890625, 0, 0.003175)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "plate_f" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </fitting/Looks/zinc>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.01349375, 0.041275, 0.00635)
        double3 xformOp:translate = (0.013890625, 0, 0.003175)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "plate_r" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </fitting/Looks/zinc>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.0142875, 0.01349375, 0.00635)
        double3 xformOp:translate = (0, -0.013890625, 0.003175)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "plate_l" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </fitting/Looks/zinc>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.0142875, 0.01349375, 0.00635)
        double3 xformOp:translate = (0, 0.013890625, 0.003175)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "PhysicsMaterials"
    {
        def Material "zinc" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:staticFriction = 0.3
            custom token physxMaterial:frictionCombineMode = "average"
        }
    }
}

