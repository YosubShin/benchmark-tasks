#usda 1.0
(
    defaultPrim = "hose_decoy"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hose_decoy" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "brass"
        {
            token outputs:surface.connect = </hose_decoy/Looks/brass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.66, 0.36)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </hose_decoy/Looks/steel/Shader.outputs:surface>

