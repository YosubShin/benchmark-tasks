#usda 1.0
(
    defaultPrim = "cap"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cap" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "brass"
        {
            token outputs:surface.connect = </cap/Looks/brass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.66, 0.36)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "alu"
        {
            token outputs:surface.connect = </cap/Looks/alu/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.78)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </cap/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.67)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </cap/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "lockout_red"
        {
            token outputs:surface.connect = </cap/Looks/lockout_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.07, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "label_yellow"
        {
            token outputs:surface.connect = </cap/Looks/label_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.98, 0.8, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </cap/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "well"
        {
            token outputs:surface.connect = </cap/Looks/well/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.22)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "target_shoulder"
        {
            token outputs:surface.connect = </cap/Looks/target_shoulder/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.33, 0.17)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "decoy_shoulder"
        {
            token outputs:surface.connect = </cap/Looks/decoy_shoulder/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.92)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "body_grey"
        {
            token outputs:surface.connect = </cap/Looks/body_grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_label"
        {
            token outputs:surface.connect = </cap/Looks/cap_label/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </cap/Looks/cap_label/tex.outputs:rgb>
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./cap_label.png@
                float2 inputs:st.connect = </cap/Looks/cap_label/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
        }
    }

    def Xform "can" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0.085)
        float3 physics:diagonalInertia = (0.0008, 0.0008, 0.0003)
        float physics:mass = 0.17
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "wall_0"
        {
            float xformOp:rotateZ = 0
            double3 xformOp:translate = (0.042499999999999996, 0, 0.0795)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "box" (
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                rel material:binding = </cap/Looks/lockout_red>
                rel material:binding:physics = </cap/PhysicsMaterials/grip> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                custom float physxCollision:contactOffset = 0.0003
                custom float physxCollision:restOffset = 0
                double size = 1
                float3 xformOp:scale = (0.003, 0.01258542, 0.159)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

