#usda 1.0
(
    defaultPrim = "fixtures"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fixtures"
{
    def "Looks"
    {
        def Material "box_red"
        {
            token outputs:surface.connect = </fixtures/Looks/box_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.05, 0.04)
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

