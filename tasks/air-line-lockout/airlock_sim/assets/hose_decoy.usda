    def Xform "anchor" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.42, -0.42, 0.00225)
        float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
        float physics:mass = 0.05
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "clamp"
        {
            float xformOp:rotateZ = 85
            double3 xformOp:translate = (0.42, -0.42, 0.00225)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "strap" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </hose_decoy/Looks/clamp>
                double size = 1
                float3 xformOp:scale = (0.014, 0.032, 0.002)
                double3 xformOp:translate = (0, 0, 0.00575)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "tail" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </hose_decoy/Looks/hose>
                double size = 1
                float3 xformOp:scale = (0.04, 0.0095, 0.0095)
                double3 xformOp:translate = (-0.02, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

