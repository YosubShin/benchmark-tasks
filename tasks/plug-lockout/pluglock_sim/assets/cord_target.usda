        def "Looks"
        {
            def Material "tag_target_color"
            {
                token outputs:surface.connect = </cord_target/cord_21/Looks/tag_target_color/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.97, 0.8, 0.06)
                    float inputs:roughness = 0.5
                    token outputs:surface
