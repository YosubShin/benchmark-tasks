        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </cord_target/anchor>
        }

        def PhysicsRevoluteJoint "cord_j00" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </cord_target/anchor>
            rel physics:body1 = </cord_target/cord_00>
            point3f physics:localPos0 = (0.1, -0.4, 0.0015)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.8598044, 0.059823062, -0.10361658, 0.4964083)
            quatf physics:localRot1 = (1, 0, 0, 0)
