    def "PhysicsMaterials"
    {
        def Material "clip" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:staticFriction = 0.3
            custom float physxMaterial:compliantContactDamping = 20
            custom float physxMaterial:compliantContactStiffness = 8000
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:staticFriction = 0.3
            custom token physxMaterial:frictionCombineMode = "min"
        }

        def Material "steel_sheet" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:staticFriction = 0.4
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }

