#usda 1.0
(
    defaultPrim = "disconnect"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "disconnect" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0
    custom int physxArticulation:solverPositionIterationCount = 32
    custom int physxArticulation:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "box_grey"
        {
            token outputs:surface.connect = </disconnect/Looks/box_grey/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.62, 0.62)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "dead_front"
        {
            token outputs:surface.connect = </disconnect/Looks/dead_front/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.68, 0.68)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "insulator"
        {
            token outputs:surface.connect = </disconnect/Looks/insulator/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.1)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

