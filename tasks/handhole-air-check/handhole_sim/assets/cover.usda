#usda 1.0
(
    defaultPrim = "cover"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cover" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.6

    def "Looks"
    {
        def Material "concrete"
        {
            token outputs:surface.connect = </cover/Looks/concrete/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.52, 0.39)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "concrete_dark"
        {
            token outputs:surface.connect = </cover/Looks/concrete_dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.45, 0.39, 0.29)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </cover/Looks/steel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.75, 0.78)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "warn_yellow"
        {
            token outputs:surface.connect = </cover/Looks/warn_yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.98, 0.82, 0.05)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </cover/Looks/black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

