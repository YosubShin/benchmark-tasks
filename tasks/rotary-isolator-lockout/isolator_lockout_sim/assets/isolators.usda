        def Material "red"
        {
            token outputs:surface.connect = </isolators/Looks/red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.06, 0.05)
                float inputs:roughness = 0.45
