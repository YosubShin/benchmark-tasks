    def Cube "block" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.1155, 0.18, 0.0442)
        double3 xformOp:translate = (0.21325, 0.05000000000000001, 0.019599999999999996)
