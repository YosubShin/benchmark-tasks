#usda 1.0
(
    defaultPrim = "stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stand"
{
    def "Looks"
    {
        def Material "station"
        {
            token outputs:surface.connect = </stand/Looks/station/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.76)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "chrome"
        {
            token outputs:surface.connect = </stand/Looks/chrome/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_green"
        {
            token outputs:surface.connect = </stand/Looks/cap_green/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.55, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "cap_red"
        {
            token outputs:surface.connect = </stand/Looks/cap_red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.06, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "stand"
        {
            token outputs:surface.connect = </stand/Looks/stand/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.42)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "legend"
        {
            token outputs:surface.connect = </stand/Looks/legend/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.04)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </stand/Looks/dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "block" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.12, 0.12, 0.0525)
        double3 xformOp:translate = (0.22000000000000003, -0.22500000000000003, 0.02375)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ped_foot" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.05, 0.05, 0.01)
        double3 xformOp:translate = (0.19, 0.05000000000000001, 0.0024999999999999996)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ped_slab" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.038, 0.022, 0.01)
        double3 xformOp:translate = (0.19, 0.05500000000000001, 0.13599999999999998)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ped_column" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </stand/Looks/stand>
        double size = 1
        float3 xformOp:scale = (0.012, 0.016, 0.1335)
        double3 xformOp:translate = (0.19, 0.05500000000000001, 0.06424999999999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

