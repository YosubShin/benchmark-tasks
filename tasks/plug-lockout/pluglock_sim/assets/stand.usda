#usda 1.0
(
    defaultPrim = "stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stand"
{
    def "Looks"
    {
        def Material "plug_black"
        {
            token outputs:surface.connect = </stand/Looks/plug_black/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

