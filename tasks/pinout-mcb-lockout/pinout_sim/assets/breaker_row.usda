    def Xform "toggle_0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.005
        double3 xformOp:translate = (-0.057, -0.035, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "lever" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </breakers/Looks/toggle_dark>
            double size = 1
            float3 xformOp:scale = (0.017, 0.007, 0.007)
            double3 xformOp:translate = (-0.0065, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "c_lever" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </breakers/Looks/toggle_dark>
            custom float physxCollision:contactOffset = 0.002
            custom float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.011, 0.007, 0.007)
            double3 xformOp:translate = (-0.0095, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

